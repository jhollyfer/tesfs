algoritmo "Primeiro Programa"

var
  contador, numero: inteiro

inicio

  numero <- 1
  escreval("Digite seu nome: ")
  leia(numero)

  enquanto contador <= numero faca
    escreval(contador)
    contador <- contador + 1
  fimenquanto

fimalgoritmo

Questão 21

Algoritmo "UmACem"
Var
   i: inteiro
Início
   i <- 1
   Enquanto i <= 100 Faça
      Escreva(i)
      i <- i + 1
   FimEnquanto
Fim


