Algoritmo "Pares"
Var
   i: inteiro
Início
   i <- 0
   Enquanto i <= 50 Faça
      Escreva(i)
      i <- i + 2
   FimEnquanto
Fim


Questão 23

Algoritmo "Tabuada"
Var
   numero, i, resultado: inteiro
Início
   Leia(numero)
   i <- 1
   Enquanto i <= 10 Faça
      resultado <- numero * i
      Escreva(numero, " x ", i, " = ", resultado)
      i <- i + 1
   FimEnquanto
Fim


Questão 24

Algoritmo "DezNumeros"
Var
   i: inteiro
   numero, soma, media: real
Início
   soma <- 0
   i <- 1
   Enquanto i <= 10 Faça
      Leia(numero)
      soma <- soma + numero
      i <- i + 1
   FimEnquanto
   media <- soma / 10
   Escreva("Soma: ", soma)
   Escreva("Média: ", media)
Fim


