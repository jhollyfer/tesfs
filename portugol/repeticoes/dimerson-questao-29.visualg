Questão 29

Algoritmo "Fibonacci"
Var
   limite, anterior, atual, quantidade, proximo: inteiro
Início
   Leia(limite)
   anterior <- 0
   atual <- 1
   quantidade <- 0
   Enquanto quantidade < limite Faça
      Escreva(anterior, " ")
      proximo <- anterior + atual
      anterior <- atual
      atual <- proximo
      quantidade <- quantidade + 1
   FimEnquanto
Fim
