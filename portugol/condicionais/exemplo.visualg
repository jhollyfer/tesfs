algoritmo "Primeiro Programa"

var
  sorteado, numero: inteiro

inicio

  sorteado <- 1
  escreval("Digite um numero: ")
  leia(numero)

  se (numero == sorteado) entao
    escreval("Você ganhou!")
  fimse

  se (numero != sorteado) entao
    escreval("Você perdeu!")
  fimse

fimalgoritmo

Questão 11

Algoritmo "PositivoNegativo"
Var
   numero: real
Início
   Leia(numero)
   Se numero >= 0 Então
      Escreva("Positivo")
   Senão
      Escreva("Negativo")
   FimSe
Fim


Questão 12

Algoritmo "ParImpar"
Var
   numero, resto: inteiro
Início
   Leia(numero)
   resto <- numero % 2
   Se resto = 0 Então
      Escreva("Par")
   Senão
      Escreva("Ímpar")
   FimSe
Fim


Questão 13

Algoritmo "MaiorDois"
Var
   n1, n2, maior: real
Início
   Leia(n1)
   Leia(n2)
   Se n1 >= n2 Então
      maior <- n1
   Senão
      maior <- n2
   FimSe
   Escreva("Maior: ", maior)
Fim


